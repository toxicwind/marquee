{
  "name": "@geode/lapidary",
  "version": "1.0.0",
  "description": "geode's transform + detect engine (all-Bun)",
  "type": "module",
  "bin": {
    "lapidary": "bin/lapidary.ts"
  },
  "exports": {
    ".": "./src/core.ts",
    "./commands/targets": "./src/commands/targets.ts",
    "./config": "./src/config.ts",
    "./pens": "./src/pens.ts",
    "./mcp": "./src/mcp.ts",
    "./http": "./src/http.ts"
  },
  "scripts": {
    "dev": "bun --hot run bin/lapidary.ts",
    "test": "bun test",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "fmt": "biome format --write .",
    "build": "bun build bin/lapidary.ts --outdir dist"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "latest",
    "bun-types": "latest",
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@ast-grep/napi": "^0.51.2",
    "ts-morph": "^28.0.0"
  },
  "private": true
}